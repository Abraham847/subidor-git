<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= repo.name %> - GitHub Uploader</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    body { background: #f8f9fa; }
    .file-row:hover { background: #f1f3f5; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/"><i class="bi bi-github me-2"></i>GitHub Uploader</a>
      <div class="navbar-nav ms-auto">
        <span class="nav-item nav-link text-muted small"><%= user.login %></span>
        <a class="nav-link" href="/logout"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <% if (success) { %>
      <div class="alert alert-success d-flex align-items-center" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-4"></i>
        <div><strong>¡Subida completada!</strong> Tus archivos ya están en <%= repo.owner %>/<%= repo.name %>.</div>
      </div>
    <% } %>
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb bg-transparent p-0 mb-0">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Inicio</a></li>
        <li class="breadcrumb-item active"><%= repo.owner %> / <%= repo.name %></li>
      </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <div>
        <h1 class="h3 mb-1"><%= repo.name %></h1>
        <span class="badge <%= repo.private ? 'bg-warning text-dark' : 'bg-success' %>">
          <%= repo.private ? 'Privado' : 'Público' %>
        </span>
      </div>
      <a href="/repo/<%= repo.owner %>/<%= repo.name %>/upload" class="btn btn-primary">
        <i class="bi bi-upload me-1"></i>Subir archivos
      </a>
    </div>

    <div class="card">
      <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-folder2-open me-2"></i>Archivos del repositorio</h5>
      </div>
      <div class="card-body p-0">
        <% if (files.length === 0) { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-folder display-1 mb-3"></i>
            <p>Este repositorio está vacío</p>
            <a href="/repo/<%= repo.owner %>/<%= repo.name %>/upload" class="btn btn-primary mt-2">Subir primer archivo</a>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Nombre</th>
                  <th class="text-end" style="width: 120px;">Tipo</th>
                  <th class="text-end" style="width: 150px;">Tamaño</th>
                </tr>
              </thead>
              <tbody>
                <% files.forEach(file => { %>
                  <tr class="file-row">
                    <td>
                      <i class="bi <%= file.type === 'dir' ? 'bi-folder-fill text-warning' : 'bi-file-earmark-text text-primary' %> me-2"></i>
                      <%= file.name %>
                    </td>
                    <td class="text-end">
                      <span class="badge bg-secondary"><%= file.type %></span>
                    </td>
                    <td class="text-end text-muted">
                      <%= file.size ? (file.size / 1024).toFixed(1) + ' KB' : '-' %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>