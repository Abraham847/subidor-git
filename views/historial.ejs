<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Historial - Subidor Git</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background: #f4f6fb; }
    .navbar-brand b { color: #2ea44f; }
    .card { border: none; border-radius: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">GitHub <b>Uploader</b></a>
      <div class="ms-auto d-flex align-items-center gap-2">
        <a href="/" class="btn btn-outline-secondary btn-sm">Inicio</a>
        <a href="/historial" class="btn btn-outline-primary btn-sm active">Mi historial</a>
        <span class="badge text-bg-light border">🏠 <%= user.login %></span>
        <form action="/logout" method="POST" class="d-inline">
          <button type="submit" class="btn btn-outline-danger btn-sm">Salir</button>
        </form>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <h4 class="mb-4"><i class="bi bi-shield-check me-2"></i>Mi historial y actividad</h4>

    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card p-3 text-center">
          <div class="fs-3 text-success"><%= stats.upload_count || 0 %></div>
          <div class="small text-muted">Subidas realizadas</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card p-3 text-center">
          <div class="fs-3 text-primary"><%= uploads.length > 0 ? 'Activo' : 'Nuevo' %></div>
          <div class="small text-muted">Estado de tu cuenta</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card p-3 text-center">
          <div class="fs-3 text-secondary"><%= totalUploads %></div>
          <div class="small text-muted">Subidas en total (todos)</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card p-3 text-center">
          <div class="fs-3 text-info"><%= totalUsers %></div>
          <div class="small text-muted">Usuarios conectados</div>
        </div>
      </div>
    </div>

    <% if (uploads.length === 0) { %>
      <div class="alert alert-info">
        Aún no has subido nada. Ve a un repositorio y pulsa <strong>Subir archivos</strong>.
      </div>
    <% } else { %>
      <div class="card p-0 table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Repositorio</th>
              <th>Archivos</th>
              <th>Ignorados</th>
              <th>Visibilidad</th>
              <th>Commit</th>
              <th>Fecha</th>
            </tr>
          </thead>
          <tbody>
            <% uploads.forEach((u, i) => { %>
              <tr>
                <td><%= u.id %></td>
                <td>
                  <a href="https://github.com/<%= u.owner %>/<%= u.repo %>" target="_blank" rel="noopener">
                    <%= u.owner %>/<%= u.repo %>
                    <i class="bi bi-box-arrow-up-right small"></i>
                  </a>
                </td>
                <td><%= u.file_count %></td>
                <td><%= u.skipped %></td>
                <td>
                  <% if (u.public_repo) { %>
                    <span class="badge text-bg-success">Público</span>
                  <% } else { %>
                    <span class="badge text-bg-danger">Privado</span>
                  <% } %>
                </td>
                <td><code class="small"><%= u.commit_sha || '—' %></code></td>
                <td class="small text-muted"><%= new Date(u.created_at).toLocaleString('es-ES') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="container pb-4">
    <div class="alert alert-warning small">
      <i class="bi bi-shield-lock me-1"></i>
      Los tokens se guardan <strong>solo en tu sesión</strong> (nunca en la base de datos). La base de datos guarda únicamente
      tu historial de subidas para tu registro personal.
    </div>
  </div>
</body>
</html>